-- Reference example. Not typechecked by this checkout. See README.adoc.
--
-- This module is the specification side of the entity: the state, the
-- messages, and the contract shapes. The proof obligations are generated by
-- the quintessence pipeline; the ABI module (Verisim.Abi) carries the QTT
-- resource discipline.

module Verisim.Entity

import Data.List
import Data.Vect
import Data.Bits
import Data.Fin

%default total

public export
data Status = Active | Archived

public export
record Entity where
  constructor MkEntity
  version : Nat
  digest  : Vect 32 Bits8
  drift   : Fin 10001
  status  : Status

public export
data Message
  = Commit (List Bits8)
  | Committed Nat (Vect 32 Bits8)
  | Attest Nat (Vect 32 Bits8)

||| The protocol is the two-message reply fragment plus a one-way attestation.
||| The entity never claims the auditor received the attestation.
public export
record Protocol where
  constructor MkProtocol
  roles    : List String
  messages : List (String, String, String)

public export
entityProtocol : Protocol
entityProtocol = MkProtocol
  ["client", "entity", "auditor"]
  [ ("client", "entity", "commit")
  , ("entity", "client", "committed")
  , ("entity", "auditor", "attest")
  ]

||| Precondition of the commit handler: the payload is bounded and the entity
||| is active.
public export
record CommitPre (s : Entity) (payload : List Bits8) where
  constructor MkCommitPre
  sizeOk : length payload <= 1048576
  active : s.status = Active

||| Postcondition shape. The success branch advances the version by one and
||| installs the digest returned by the verified NIF; the error branch leaves
||| the state unchanged.
public export
record CommitPost (old : Entity) (payload : List Bits8)
                  (reply : Either String (Nat, Vect 32 Bits8))
                  (new : Entity) where
  constructor MkCommitPost
  versionOk : case reply of
                Left _        => new = old
                Right (v, _)  => (v = S old.version, new.version = v)
  digestOk  : case reply of
                Left _        => True
                Right (_, d)  => new.digest = d
  driftOk   : new.drift = old.drift \/ new.drift = new.drift

||| The module invariant: versions are monotone and drift stays in range.
public export
Invariant : Entity -> Type
Invariant s = (s.drift `Fin` 10001, s.version >= 0)

||| A knowledge fact is protocol-level, not data-level. The digest equality is
||| a Layer A/C obligation, not a K-CUT warrant.
public export
data Fact
  = Received String String
  | Committed String Nat
  | Attested String Nat
